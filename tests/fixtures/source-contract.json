            "enum": [
              "rating",
              "relevance",
              "view_count",
              "upload_date"
            ]
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "enum": [
              "video",
              "channel",
              "playlist",
              "movie"
            ]
          },
          "upload_date": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "enum": [
              "today",
              "last_hour",
              "this_week",
              "this_month",
              "this_year"
            ]
          },
          "3d": {
            "type": "boolean"
          },
