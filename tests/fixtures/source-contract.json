        "pattern": "^[A-Za-z0-9-]+$",
        "default": "en"
      },
      "auto": {
        "type": "boolean",
        "default": true,
        "description": "true selects automatically generated captions; false selects manually provided captions. Does not fall back between the two."
      }
    },
    "required": [
      "video_id"
    ]
  },
