      "query"
    ]
  },
  "youtube_download": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "video_id": {
        "type": "string",
        "minLength": 11,
        "maxLength": 11,
        "pattern": "^[A-Za-z0-9_-]{11}$"
      },
      "download_type": {
        "type": "string",
        "minLength": 1,
        "maxLength": 11,
        "default": "audio_video",
        "enum": [
          "audio_video",
          "video",
          "audio"
        ]
      },
      "video_quality": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "default": "<=720",
        "enum": [
          "best",
          "worst",
          "<=144",
          "==144",
          ">=144",
          "<=360",
          "==360",
          ">=360",
          "<=480",
          "==480",
          ">=480",
          "<=720",
          "==720",
          ">=720",
          "<=1080",
          "==1080",
          ">=1080",
          "<=1440",
          "==1440",
          ">=1440",
          "<=2160",
          "==2160",
          ">=2160",
          "<=4320",
          "==4320",
          ">=4320"
        ]
      },
      "fps": {
        "type": "string",
        "minLength": 1,
        "maxLength": 6,
        "pattern": "^(?:>=|<=|==)(?:[1-9]\\d?|1\\d\\d|2[0-3]\\d|240)$"
      },
      "audio_language": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8,
        "default": "default",
        "enum": [
          "default",
          "original"
        ]
      },
      "audio_quality": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10,
        "default": "best",
        "enum": [
          "best",
          "320",
          "256",
          "192",
          "128"
        ]
      },
      "yt_dlp_format": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "upload_metadata": {
        "type": "boolean",
        "default": false
      },
      "output_format": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10,
        "default": "mp4",
        "enum": [
          "mp4",
          "webm",
          "mkv",
          "m4a",
          "mp3",
          "opus"
        ]
      },
      "start_at": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8,
        "pattern": "^\\d{1,2}:[0-5]\\d:[0-5]\\d$"
      },
      "end_at": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8,
        "pattern": "^\\d{1,2}:[0-5]\\d:[0-5]\\d$"
      }
    },
    "required": [
      "video_id"
    ]
  }
}
